# Copy to frontend/.env and adjust per environment.
# Vite inlines VITE_* values at `npm run build` — set the target API URL
# before building for a deploy (local / dev / prod).

# FastAPI origin, no trailing slash. Local default: http://localhost:8000
# Leave empty only if the UI and API are served from the same origin.
VITE_API_BASE_URL=http://localhost:8000

# Shown in the browser tab.
VITE_APP_NAME=One Category Pager

# Login "View access instructions" link. Leave empty until the real URL exists.
VITE_ACCESS_INSTRUCTIONS_URL=
